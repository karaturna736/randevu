[Unit]
Description=Neta Randevu slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neta
Group=neta
WorkingDirectory=/opt/neta/slots/%i
EnvironmentFile=/etc/neta/neta.env
ExecStart=/usr/bin/env NODE_ENV=production HOSTNAME=127.0.0.1 PORT=%i /usr/bin/node server.js
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neta /var/backups/neta
RestrictSUIDSGID=true
LockPersonality=true
# Node/V8 JIT needs to create executable code pages at runtime. Enabling
# MemoryDenyWriteExecute makes the candidate slot core-dump before health checks.
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
