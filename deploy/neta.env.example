# Root-owned file installed at /etc/neta/neta.env (mode 0600).
# Never commit real credentials or payment provider secrets.
PUBLIC_APP_URL=https://netarandevu.com
PUBLIC_SITE_READY=true
DATABASE_PATH=/var/lib/neta/neta.sqlite
BACKUP_DIRECTORY=/var/backups/neta

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PLATFORM_ADMIN_USER_IDS=
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_EMAIL_BOOTSTRAP=false

AUTOMATION_SECRET=GENERATE_ON_SERVER
APP_ENCRYPTION_KEY=GENERATE_ON_SERVER

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_BANK_LABEL=

NETA_PLANS_JSON=[]
RECURRING_SALES_ENABLED=false
IYZICO_LIVE=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
NETA_SELLER_NAME=
NETA_SELLER_ADDRESS=
NETA_SUPPORT_EMAIL=
NETA_SUBSCRIPTION_TERMS_URL=https://netarandevu.com/kosullar

NETA_DATA_CONTROLLER_NAME=
NETA_DATA_CONTROLLER_ADDRESS=
NETA_DATA_CONTROLLER_EMAIL=
NETA_DATA_CONTROLLER_KEP=

WHATSAPP_CONNECTIONS_JSON=[]
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v20.0
RECALL_SCHEDULER_READY=false

HELP_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
