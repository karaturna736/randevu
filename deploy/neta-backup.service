[Unit]
Description=Neta SQLite backup

[Service]
Type=oneshot
User=neta
Group=neta
WorkingDirectory=/opt/neta/current
EnvironmentFile=/etc/neta/neta.env
ExecStart=/usr/bin/node scripts/backup-sqlite.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neta /var/backups/neta
